# LandSetu Backend — Environment Variables
# Copy this file to .env and edit as needed.

# Application
APP_NAME=LandSetu
APP_VERSION=0.1.0
DEBUG=true

# Database
DATABASE_PATH=landsetu.db

# CORS — allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server
HOST=0.0.0.0
PORT=8000

# AI / LLM Configuration (Optional — defaults to Deterministic Grounded Prototype Mode if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=
